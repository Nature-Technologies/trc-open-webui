# TRC staging environment contract for open-webui.
#
# NOTHING RENDERS THIS FILE, and there is no `.env.staging` any more. The deploy
# workflow (.github/workflows/trc-staging-deploy.yml) binds every variable below
# as the `env:` of its own "Deploy" step, and Compose resolves the compose
# file's ${...} references straight from that process environment -- no
# `--env-file`, no file on the runner, none on the server. Two consequences:
# no secret touches disk anywhere, and because nothing is dotenv-parsed, values
# are taken literally, so a `$`, backtick or `#` in a secret survives instead of
# being interpolated or truncated. (The workflow used to reject those three
# characters outright for exactly that reason; it no longer needs to.)
#
# So this file is now two things, neither of them a template to copy:
#   - the documented contract for what the deploy must supply, and
#   - the key list deploy/trc/validate_compose.py fills with placeholders to
#     prove `docker compose config` renders.
# Only the KEYS are read; the values below are illustrative. The validator
# asserts both directions: every ${VAR} the compose file references is listed
# here, AND every one of them is bound in the "Deploy" step's `env:` -- since
# with no env file, that step's environment is the only thing that supplies
# them, and Compose substitutes an empty string with a mere warning for a plain
# ${VAR}.

# Image to deploy. Both tags the workflow builds -- the moving `:staging`
# pointer and the IMMUTABLE `:git-<7-char-sha>` naming the exact commit -- land
# ONLY in the deploy host's own image store. Nothing is pushed to GHCR; the
# `ghcr.io/...` spelling below is just a local tag name kept for continuity with
# the retired publish-then-pull scheme. `OPENWEBUI_IMAGE` is always the
# `:git-<7>` tag, never `:staging`, so "what is running" is unambiguous and
# cannot be moved under the deploy by a later, unrelated run.
#
# ROLLBACK IS HOST-LOCAL as a result: these tags exist on one machine, and a
# `docker image prune -a` or a host rebuild destroys every rollback target. To
# roll back, follow docs/deploy/trc-staging.md, which dispatches from a
# throwaway branch with the "Deploy" step's OPENWEBUI_IMAGE env line hardcoded
# to an older `:git-<7>` tag that is still in that host's store.
OPENWEBUI_IMAGE=ghcr.io/nature-technologies/trc-open-webui:git-d549849

# Secret. Used here as OPENAI_API_KEY against the Hermes gateway.
#
# SHARED VALUE: identical to trc-hermes-agent's HERMES_API_KEY, and to a third
# copy inside Paperclip's instance config.json. A mismatch is caught by this
# repo's deploy smoke test, which calls the gateway from inside the container
# so it reads the deployed value rather than a copy.
#
# Must be at least 16 characters. The deploy checks this before the build, in
# its "Verify the shared gateway key" step: below 16 the gateway refuses to
# start its API server at all, so the symptom is connection-refused on :8642
# rather than a 401.
HERMES_API_KEY=

# Secret. HS256 key signing X-OpenWebUI-User-Jwt.
#
# TWO-REPO SECRET: trc-backend calls the same value IDENTITY_JWT_SECRET and
# also needs ENFORCE_VERIFIED_IDENTITY=true. The two MUST be identical, and
# nothing on either side detects a mismatch: Open WebUI signs the JWT
# regardless and the rejection surfaces in trc-backend. Symptom:
# identity-verified requests rejected while ordinary chat works. The deploy
# publishes a fingerprint to /srv/trc/staging/fingerprints/openwebui-jwt so the
# two sides can be compared.
#   openssl rand -hex 32
OPENWEBUI_JWT_SECRET=

# Host bind address. Reachable on any host interface by default.
OPENWEBUI_BIND=0.0.0.0

# Where trc-backend answers, over the shared trc-shared network. Not a secret;
# bound as a literal in the "Deploy" step's env, the same way OPENWEBUI_BIND is.
# The chat-deletion hook posts to <base>/api/redaction/forget and
# /api/redaction/forget-user so deleted chats' PII mappings are purged promptly
# rather than at the next reconciling sweep.
RAGNAROK_BASE_URL=http://app:8000

# Secret. The service-realm bearer for trc-backend's /api/redaction/* routes.
#
# TWO-REPO SECRET: trc-backend calls the identical value REDACTION_SERVICE_KEY.
# A mismatch is SILENT on this side -- the deletion hook is best effort and
# swallows the 401 rather than failing the deletion -- and shows up only as PII
# mappings that outlive their chat until trc-backend's own sweep collects them.
# It is the same key the redaction filter already uses for /redact and /unmask.
#   openssl rand -hex 32
RAGNAROK_SERVICE_KEY=
