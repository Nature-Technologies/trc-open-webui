# TRC staging environment for open-webui.
#
# The deploy workflow (.github/workflows/trc-staging-deploy.yml) renders the
# real .env from repository secrets and copies it to
# /srv/trc/staging/open-webui/.env at mode 0600. This file is documentation and
# is also parsed by deploy/trc/validate_compose.py, which fills each key with a
# placeholder to prove `docker compose config` renders. Every variable the
# compose file references must be listed here.

# Digest-pinned image, written by CI from the workflow's `image_digest` input.
OPENWEBUI_IMAGE=ghcr.io/nature-technologies/trc-open-webui@sha256:REPLACE_ME

# Secret. Used here as OPENAI_API_KEY against the Hermes gateway.
#
# SHARED VALUE: identical to trc-hermes-agent's HERMES_API_KEY, and to a third
# copy inside Paperclip's instance config.json. A mismatch is caught by this
# repo's deploy smoke test, which calls the gateway from inside the container
# so it reads the deployed value rather than a copy.
HERMES_API_KEY=

# Secret. HS256 key signing X-OpenWebUI-User-Jwt.
#
# TWO-REPO SECRET: trc-backend calls the same value IDENTITY_JWT_SECRET and
# also needs ENFORCE_VERIFIED_IDENTITY=true. The two MUST be identical, and
# nothing on either side detects a mismatch: Open WebUI signs the JWT
# regardless and the rejection surfaces in trc-backend. Symptom:
# identity-verified requests rejected while ordinary chat works. The deploy
# publishes a fingerprint to /srv/trc/staging/fingerprints/openwebui-jwt so the
# two sides can be compared.
#   openssl rand -hex 32
OPENWEBUI_JWT_SECRET=

# Host bind address. Reachable on any host interface by default.
OPENWEBUI_BIND=0.0.0.0
