# RETIRED FOR TRC -- arrived from upstream in the 0.10.2 -> current merge.
#
# This is upstream's community issue-triage automation, not something the TRC
# fork wants running. It fires on every issue opened here, takes `issues:
# write`, and adds a `bug` label keyed on headings from upstream's issue forms
# ("Installation Method", "Open WebUI Version") -- forms this fork's issues do
# not use. Where the `bug` label does not exist in this repo's label set the
# addLabels call simply fails, hanging a red X on every issue opened.
#
# Retired by RENAME rather than deletion, the same way docker.yaml, release.yml
# and release-pypi.yml were. The rename is what makes the retirement survive:
# git follows it, so upstream's future edits merge into this inert file instead
# of resurrecting an active one -- exactly what happened to docker.yaml.disabled
# in this merge, which absorbed 12 lines of upstream changes without ever
# becoming live again. A deletion would instead raise a delete/modify conflict
# on every merge that touches this file, and one "take theirs" resolution would
# silently switch it back on.
name: Issue Labeler

on:
  issues:
    types: [opened]

permissions:
  issues: write

jobs:
  label-bug-reports:
    runs-on: ubuntu-latest
    steps:
      - name: Add "bug" label to unlabeled bug reports
        uses: actions/github-script@v7
        with:
          script: |
            const issue = context.payload.issue;

            // Web-form submissions already carry the label from the issue template
            if (issue.labels.some((label) => label.name === 'bug')) {
              return;
            }

            const title = issue.title ?? '';
            const body = issue.body ?? '';

            // Freeform bug reports: "issue: ...", "bug: ...", "fix: ...", "[Bug] ...", "issue/UX: ..."
            const bugLikeTitle = /^\s*\[?(bug|issue|fix)\]?\s*[:/\-]/i.test(title);

            // API/CLI-created issues that reproduce the bug report form structure.
            // Only headings distinctive to the bug form (both are required fields there) —
            // generic headings like "Expected Behavior" also appear in freeform feature requests.
            const bugFormBody = /###\s*(Installation Method|Open WebUI Version)/i.test(body);

            if (bugLikeTitle || bugFormBody) {
              await github.rest.issues.addLabels({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: issue.number,
                labels: ['bug']
              });
            }
